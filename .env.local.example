# Local Supabase stack (started with `npm run db:start`).
# Copy this file to .env.local and paste the local anon key printed by
# `npx supabase status` (the "anon key" / ANON_KEY value). Local keys only:
# never put keys of a hosted Supabase project here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-local-anon-key-here

# Used in auth redirects and certificate links
NEXT_PUBLIC_APP_URL=http://localhost:3000
